# ShellBench house style for matplotlib (file: src/shellbench/shellbench.mplstyle)
#
# Applied by shellbench.style.apply(). Sizes are in points at the printed size,
# because every figure is drawn at its final width (90, 140 or 190 mm).
#
# Sources for the fixed values:
# - Fonts: Elsevier "Artwork overview" recommends Arial (or Helvetica), Courier,
#   Symbol and Times. Liberation Sans is the metric-compatible Arial on Linux.
#   https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-overview
# - 7 pt normal lettering, 6 pt minimum for sub/superscripts: Elsevier
#   "Artwork sizing". https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-sizing
# - Colours: dataviz reference palette, categorical slots in fixed order,
#   checked with its validator (see docs/visual_standard.md).
# - Line weights, tick lengths and grid tone are house choices [J], listed in
#   docs/visual_standard.md.

# ---- Type ----------------------------------------------------------------
font.family         : sans-serif
font.sans-serif     : Arial, Liberation Sans, Helvetica, DejaVu Sans
font.size           : 7.0
axes.labelsize      : 7.0
axes.titlesize      : 7.5
axes.titleweight    : bold
axes.titlelocation  : left
axes.titlepad       : 6.0
xtick.labelsize     : 7.0
ytick.labelsize     : 7.0
legend.fontsize     : 7.0
legend.title_fontsize : 7.0
figure.titlesize    : 8.0
mathtext.default    : regular
axes.unicode_minus  : True

# ---- Ink -------------------------------------------------------------------
text.color          : 0b0b0b
axes.labelcolor     : 0b0b0b
axes.edgecolor      : 52514e
xtick.color         : 52514e
ytick.color         : 52514e
xtick.labelcolor    : 0b0b0b
ytick.labelcolor    : 0b0b0b
figure.facecolor    : ffffff
axes.facecolor      : ffffff
savefig.facecolor   : ffffff

# ---- Axes and ticks ----------------------------------------------------------
axes.linewidth      : 0.6
axes.spines.top     : False
axes.spines.right   : False
axes.axisbelow      : True
axes.grid           : False
axes.xmargin        : 0.02
axes.ymargin        : 0.04
axes.labelpad       : 3.0
axes.prop_cycle     : cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])
xtick.direction     : out
ytick.direction     : out
xtick.major.size    : 3.0
ytick.major.size    : 3.0
xtick.minor.size    : 1.6
ytick.minor.size    : 1.6
xtick.major.width   : 0.6
ytick.major.width   : 0.6
xtick.minor.width   : 0.5
ytick.minor.width   : 0.5
xtick.major.pad     : 2.0
ytick.major.pad     : 2.0
grid.color          : e1e0d9
grid.linewidth      : 0.4
grid.linestyle      : -

# ---- Marks -------------------------------------------------------------------
lines.linewidth     : 1.25
lines.markersize    : 4.0
lines.markeredgewidth : 0.8
lines.solid_capstyle : round
lines.dash_capstyle : round
patch.linewidth     : 0.0
scatter.edgecolors  : none
errorbar.capsize    : 0.0

# ---- Legend ------------------------------------------------------------------
legend.frameon      : False
legend.borderpad    : 0.2
legend.borderaxespad : 0.3
legend.handlelength : 1.8
legend.handletextpad : 0.5
legend.labelspacing : 0.35
legend.columnspacing : 1.2

# ---- Output ------------------------------------------------------------------
figure.dpi          : 150
savefig.dpi         : 600
savefig.bbox        : standard
savefig.pad_inches  : 0.02
pdf.fonttype        : 42
ps.fonttype         : 42
svg.fonttype        : none
svg.hashsalt        : shellbench
figure.constrained_layout.use : True
figure.constrained_layout.h_pad : 0.03
figure.constrained_layout.w_pad : 0.03
